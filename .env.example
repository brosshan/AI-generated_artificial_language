# ==============================================================================
# AI 簡報導讀影音工作台 - 環境設定範本 (.env.example)
# 複製此檔案為 .env 並依需求調整；切勿將含有真實 API Key 的 .env 提交至版本庫。
# ==============================================================================

# [服務網路與安全設定]
# 伺服器監聽 IP 與 Port (本機建議維持 127.0.0.1)
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# [選填] 全域 API 驗證 Token (留空則不啟用，啟用後所有 API 需 Bearer Token)
STUDIO_API_TOKEN=

# [模型服務端點設定]
# 本機 Ollama API 服務端點
OLLAMA_URL=http://127.0.0.1:11434

# 預設使用的視覺多模態模型名稱 (需支援圖片輸入，如 gemma4:31b-cloud 或 qwen2.5-vl)
OLLAMA_MODEL=gemma4:31b-cloud

# [系統路徑設定]
# 專案工作資料夾 (存放暫存拆頁圖、音訊與合成影片)
PRESENTATION_WORKSPACE=workspace

# 外部工具執行檔自訂路徑 (若已加入系統 PATH 則維持預設名稱即可)
SOFFICE_PATH=soffice
FFMPEG_PATH=ffmpeg

# [轉換與渲染參數限制]
MAX_UPLOAD_BYTES=52428800
MAX_SLIDES=300
RENDER_DPI=150
MAX_RENDER_PIXELS=25000000

